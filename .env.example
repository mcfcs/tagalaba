# Copy to .env and fill in. .env is git-ignored.
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=...

# Optional overrides (defaults shown):
# TAGALABA_GEN_PROVIDER=anthropic        # anthropic (works w/ your Claude key) | gemini
# TAGALABA_ANTHROPIC_GEN_MODEL=claude-sonnet-4-6
# TAGALABA_GEN_MODEL=gemini-2.5-flash    # used only when provider=gemini
#   (gemini-3.5-flash also available if you want to try a newer model)
# TAGALABA_VERIFY_MODEL=claude-haiku-4-5-20251001
# TAGALABA_RPM=12                          # requests/min cap
